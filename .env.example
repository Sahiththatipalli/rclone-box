# Copy to .env for local dev. DO NOT COMMIT .env.
# Production: read these from AWS Secrets Manager instead (set AWS_SECRET_ID).

# --- Anthropic (required for the agent) ---
ANTHROPIC_API_KEY=

# --- AWS ---
# For local dev, use `aws configure` or an SSO profile; AWS_PROFILE takes precedence.
# AWS_PROFILE=default
AWS_REGION=ca-central-1

# The S3 bucket + prefix rclone syncs Box into.
BOX_BACKUP_BUCKET=ninepoint-box-backup-prod
BOX_BACKUP_PREFIX=box-backup

# --- Box admin console (browser tool) ---
# The Box tenant sign-in URL your admin uses. Usually https://<subdomain>.app.box.com/master
# or https://app.box.com/master if you don't have a vanity subdomain.
BOX_ADMIN_URL=https://app.box.com/master

# Where to persist the Playwright storage state after `login`. Gitignored.
# Anyone with this file can act as your admin — treat it like a credential.
BOX_STORAGE_STATE=./storage_state.json

# --- Agent runtime ---
# Directory the agent writes findings and reports to. Gitignored.
AGENT_RUN_DIR=./runs

# --- Optional: pull secrets from AWS Secrets Manager instead of env ---
# Set this to a secret ID/ARN containing a JSON object with any of the keys above.
# When set, values from Secrets Manager win over env vars.
# AWS_SECRET_ID=rclone-box-auditor/local-dev
